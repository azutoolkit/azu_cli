name: <%= @project.downcase %>
version: 0.1.0
authors:
  - <%= @author %> <<%= @email %>>
crystal: '>= 1.22.1'
license: <%= @license %>

targets:
  <%= @project.downcase.gsub(/[^a-z0-9_]/, "_") %>:
    main: src/<% if @project_type == "web" %>server.cr<% elsif @project_type == "api" %>api.cr<% elsif @project_type == "cli" %><%= @project %>.cr<% else %>server.cr<% end %>
<% if @include_example && @project_type != "cli" -%>
  tasks:
    main: src/tasks.cr
<% end -%>
<% unless @project_type == "cli" -%>

dependencies:
  # Azu 1.0.2 plus request-telemetry redaction. Replace this exact
  # commit with the first released version containing it after compatibility CI passes.
  azu:
    github: azutoolkit/azu
    commit: 69163988a48e28b809ad09929f5d7f9bfb1079ee

  # Tested stable ORM release; update together with compatibility CI and lockfiles.
  cql:
    github: azutoolkit/cql
    version: 1.0.0

  # ~> 1.1, not ~> 1.0.31: the stray v1.0.32 tag is a pull-request merge ref, not a release.
  session:
    github: azutoolkit/session
    version: ~> 1.1

  # Optional: Uncomment if you need email functionality
  # carbon:
  #   github: luckyframework/carbon

<% if has_joobq? -%>
  # The generated jobs, worker and initializer are compiled against this release (scripts/e2e_generated_app.sh)
  joobq:
    github: azutoolkit/joobq
    version: ~> 0.4.2

  redis:
    github: stefanwille/crystal-redis

<% end -%>
  topia:
    github: azutoolkit/topia

<% if @database == "postgresql" || @database == "postgres" || @database == "pg" -%>
  pg:
    github: will/crystal-pg
    version: ~> 0.31.0
<% elsif @database == "mysql" -%>
  mysql:
    github: crystal-lang/crystal-mysql
    version: ~> 0.18.0
<% elsif @database == "sqlite" || @database == "sqlite3" -%>
  sqlite3:
    github: crystal-lang/crystal-sqlite3
    version: ~> 0.24.0
<% end -%>
<% end -%>

<% if @test_framework == "minitest" -%>
development_dependencies:
  minitest:
    github: ysbaddaden/minitest.cr
<% end -%>
