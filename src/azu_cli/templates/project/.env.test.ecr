# Settings for CRYSTAL_ENV=test (`azu test`, `crystal spec`). No secrets here: this file may be committed.
<% if database_adapter == "sqlite3" -%>
DATABASE_URL=sqlite3://./db/<%= @project.downcase %>_test.db
<% elsif database_adapter == "mysql" -%>
DATABASE_URL=mysql://root@localhost:3306/<%= @project.downcase %>_test_db
<% else -%>
DATABASE_URL=postgres://postgres:@localhost:5432/<%= @project.downcase %>_test_db
<% end -%>
