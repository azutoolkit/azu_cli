{% extends "app_layout.jinja" %}
{% block title %}Welcome to {{ project_title }}{% endblock %}
{% block description %}Your Azu workspace. Turn your next idea into a working application.{% endblock %}
{% block head %}{{ csrf_metatag | safe }}{% endblock %}
{% block content %}
<div class="mx-auto max-w-6xl space-y-10">
  <section class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_20rem]" aria-labelledby="hero-title">
    <div class="card border border-base-300 bg-base-100 shadow-sm">
      <div class="card-body gap-6 p-6 sm:p-10">
        <div class="flex flex-wrap gap-2"><span class="badge badge-success badge-soft gap-2"><span class="status status-success"></span>App is running</span><span class="badge badge-ghost">{{ environment }}</span></div>
        <div class="space-y-4"><p class="text-xs font-semibold uppercase tracking-widest text-primary">Welcome to {{ project_title }}</p>
          <h1 class="max-w-xl text-4xl font-semibold tracking-tight sm:text-5xl leading-tight" id="hero-title">A fresh start.<br><span class="text-primary">Make something great.</span></h1>
          <p class="max-w-xl text-base leading-relaxed text-base-content/70">Your workspace is ready. Go from an idea to a working app with typed contracts, beautiful pages, and Real-time updates built in.</p>
        </div>
        <div class="card-actions gap-3"><a class="btn btn-primary" href="#next-steps">Build your first page <span aria-hidden="true">→</span></a><a class="btn btn-ghost" href="https://azutoolkit.org" rel="noopener noreferrer">Read the docs ↗</a></div>
      </div>
    </div>
    <div class="card border border-base-300 bg-base-100 shadow-sm"><div class="card-body gap-5 p-6">
      <div class="flex items-center justify-between"><h2 class="font-semibold">Your environment</h2><span class="status status-success" aria-label="Running"></span></div>
      <p class="text-sm text-base-content/70">Everything you need. Ready to build.</p>
      <dl class="divide-y divide-base-300 text-sm">
        <div class="flex justify-between gap-4 py-4"><dt class="text-base-content/60">Azu</dt><dd class="font-mono font-medium">{{ azu_version }}</dd></div>
        <div class="flex justify-between gap-4 py-4"><dt class="text-base-content/60">Crystal</dt><dd class="font-mono font-medium">{{ crystal_version }}</dd></div>
        <div class="flex justify-between gap-4 py-4"><dt class="text-base-content/60">Application</dt><dd class="font-mono font-medium">{{ app_version }}</dd></div>
        <div class="flex justify-between gap-4 py-4"><dt class="text-base-content/60">UI</dt><dd class="font-medium">daisyUI + Tailwind</dd></div>
      </dl>
    </div></div>
  </section>
  <section class="grid gap-4 md:grid-cols-3" aria-label="Built for productive development">
    <article class="card border border-base-300 bg-base-100"><div class="card-body gap-3 p-6"><span class="badge badge-primary badge-soft">01 / Reliable</span><h2 class="card-title text-lg">Typed contracts</h2><p class="text-sm leading-relaxed text-base-content/70">Validated requests and checked responses. Catch mistakes while you build.</p></div></article>
    <article class="card border border-base-300 bg-base-100"><div class="card-body gap-3 p-6"><span class="badge badge-primary badge-soft">02 / Connected</span><h2 class="card-title text-lg">Real-time by default</h2><p class="text-sm leading-relaxed text-base-content/70">Channels and Spark components bring live updates to your application.</p></div></article>
    <article class="card border border-base-300 bg-base-100"><div class="card-body gap-3 p-6"><span class="badge badge-primary badge-soft">03 / Yours</span><h2 class="card-title text-lg">A head start on every page</h2><p class="text-sm leading-relaxed text-base-content/70">Editable daisyUI components, responsive layouts, and navigation that grows with your app.</p></div></article>
  </section>
  <section class="space-y-5" id="next-steps" aria-labelledby="steps-title">
    <div class="flex flex-wrap items-end justify-between gap-3"><div><p class="text-xs font-semibold uppercase tracking-widest text-primary">Your next steps</p><h2 class="mt-2 text-2xl font-semibold tracking-tight" id="steps-title">An idea to an app. Three commands.</h2></div><span class="badge badge-outline">Run in {{ project }}</span></div>
    <ol class="grid gap-4 lg:grid-cols-3" role="list">
      <li class="card border border-base-300 bg-base-100"><div class="card-body p-5 gap-4"><span class="text-sm font-mono text-primary">01</span><h3 class="font-semibold">Generate your first resource</h3><p class="text-sm text-base-content/70">Models, forms, pages, and a navigation link. All ready to edit.</p><div class="rounded-box bg-base-200 p-3 space-y-3"><code class="block break-words text-xs">azu generate scaffold Post title:string</code><button class="btn btn-xs btn-ghost" type="button" data-copy="azu generate scaffold Post title:string" hidden><span data-copy-label>Copy command</span></button></div></div></li>
      <li class="card border border-base-300 bg-base-100"><div class="card-body p-5 gap-4"><span class="text-sm font-mono text-primary">02</span><h3 class="font-semibold">Prepare your database</h3><p class="text-sm text-base-content/70">Apply the migration and get your new resource ready for real data.</p><div class="rounded-box bg-base-200 p-3 space-y-3"><code class="block break-words text-xs">azu db:migrate</code><button class="btn btn-xs btn-ghost" type="button" data-copy="azu db:migrate" hidden><span data-copy-label>Copy command</span></button></div></div></li>
      <li class="card border border-base-300 bg-base-100"><div class="card-body p-5 gap-4"><span class="text-sm font-mono text-primary">03</span><h3 class="font-semibold">Bring it to life</h3><p class="text-sm text-base-content/70">Start your app, then open your new section from the navigation.</p><div class="rounded-box bg-base-200 p-3 space-y-3"><code class="block break-words text-xs">azu serve</code><button class="btn btn-xs btn-ghost" type="button" data-copy="azu serve" hidden><span data-copy-label>Copy command</span></button></div></div></li>
    </ol>
    <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>
  </section>
  <section class="card border border-base-300 bg-base-100" aria-labelledby="route-title"><div class="card-body p-6 gap-4">
    <div class="flex flex-wrap justify-between gap-3"><div><h2 class="card-title" id="route-title">Make this workspace your own</h2><p class="mt-2 text-sm text-base-content/70">Edit your templates, customize your theme, and start building.</p></div><a class="btn btn-sm btn-ghost" href="https://daisyui.com/components/" rel="noopener noreferrer">Explore components ↗</a></div>
    <div class="flex flex-wrap items-center gap-3 rounded-box bg-base-200 p-4 text-sm"><span class="badge badge-success badge-soft">GET /</span><code class="break-all">{{ module_name }}::Welcome::IndexEndpoint</code></div>
    <p class="text-xs text-base-content/60 break-words">Start in public/templates. Customize frontend/app.css with npm run watch:css.</p>
  </div></section>
</div>
{% endblock %}
