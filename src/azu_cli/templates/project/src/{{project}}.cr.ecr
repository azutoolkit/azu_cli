<% if @project_type == "cli" -%>
require "option_parser"

module <%= @module_name %>
  VERSION = "0.1.0"

  def self.run(args : Array(String))
    option_parser = OptionParser.parse(args) do |parser|
      parser.banner = "Usage: <%= @project %> [options]"

      parser.on("-v", "--version", "Show version") do
        puts "v#{VERSION}"
        exit
      end

      parser.on("-h", "--help", "Show help") do
        puts parser
        exit
      end

<% if @include_example -%>
      parser.on("--hello NAME", "Say hello to NAME") do |name|
        puts "Hello, #{name}!"
        exit
      end
<% end -%>
    end

<% if @include_example -%>
    # If no arguments provided, show help
    if args.empty?
      puts option_parser
      exit
    end
<% end -%>
  end
end

# The specs (CRYSTAL_ENV=test) load this file without running the program.
<%= @module_name %>.run(ARGV) unless ENV["CRYSTAL_ENV"]? == "test"
<% else -%>
# Load .env, .env.<CRYSTAL_ENV> and .env.local from the working directory before azu is required: Azu::CONFIG
# reads PORT, HOST and CRYSTAL_ENV when it is created. A variable already in the process environment always
# wins, so a container that injects real values is unaffected. See docs/reference/configuration/env.md in azu.
require "azu/env"
Azu::Env.load_all
require "azu"
# The development dashboard and performance monitor live behind azu/dev (needs azu >= 0.5.118).
require "azu/dev"
require "./initializers/**"
# Only the schema: src/db/seed.cr would run on every boot, and `azu db:migrate` requires the migrations itself.
require "./db/schema"

# Azu Framework Application
# Docs: https://azutoolkit.org
module <%= @module_name %>
  include Azu
  VERSION = "0.1.0"

  configure do |c|
<% if @project_type == "api" -%>
    # API Configuration
    # Uncomment to enable CORS
    # c.router.before "*", Handler::CORS.new
<% else -%>
    # Web Application Configuration
    # Uncomment to enable Spark real time apps
    # Docs: https://azutoolkit.org/spark
    # c.router.ws "/live-view", Spark
    c.templates.path = "./public/templates"
<% end -%>
  end

<% if @project_type == "web" -%>
  Azu::Handler::CSRF.configure do |csrf|
    csrf.strategy = Azu::Handler::CSRF::Strategy::SignedDoubleSubmit
    # CSRF_SECRET comes from the environment or the git-ignored .env. Development falls back to a random key per
    # process (forms break behind several processes); production refuses to boot without it.
    csrf.secret_key = Azu::Env.secret("CSRF_SECRET")
  end

<% end -%>
  # A typed array: handing Azu an array of a union of handler classes as Array(HTTP::Handler) corrupts it
  # in optimized builds (IndexError / SIGSEGV at boot).
  def self.handlers : Array(HTTP::Handler)
    [
<% if @project_type == "web" -%>
      Azu::Handler::CSRF.default, # the instance configured above signs the tokens the forms render
<% end -%>
      Azu::Handler::RequestId.new,
      *dev_handlers,
      # Logger outside Rescuer, as azu's default_handlers: it logs the status the Rescuer set (a 404, not a 200).
      Azu::Handler::Logger.new,
      Azu::Handler::Rescuer.new,
      # HSTS only when this app terminates TLS itself (Azu::CONFIG.tls?); a TLS-terminating proxy must add it.
      Azu::Handler::SecurityHeaders.new(hsts: Azu::CONFIG.tls?),
<% if @project_type == "web" -%>
      # Static files from public/: a missing file falls through to the router, so azu's own 404 answers it
      # (a handler used as a route has no next handler and would answer with a bare text/plain 404).
      # except: never serves /templates from public/ (the Jinja sources), whatever the case, encoding or dot segments
      # of the path; routes of your own under /templates still work, the router answers them.
      Azu::Handler::Static.new(except: ["/templates"]),
<% end -%>
    ] of HTTP::Handler
  end

  # Development tooling (query dashboard, performance monitor); decided when the app boots, so a
  # production process never serves it. This is the one place that wires it. The dashboard reads the
  # requests that Azu::CONFIG.performance_monitor records, which exists when PERFORMANCE_MONITORING=true
  # (.env.development sets it); mounting that same monitor is what fills the dashboard.
  def self.dev_handlers : Array(HTTP::Handler)
    return [] of HTTP::Handler unless Azu::CONFIG.env.development?

    handlers = [Azu::Handler::DevDashboard.new] of HTTP::Handler
    if monitor = Azu::CONFIG.performance_monitor
      handlers << monitor
    end
    handlers
  end
end

require "./mailers/**"
require "./models/**"
require "./requests/**"
require "./validators/**"
require "./services/**"
require "./components/**"
require "./middleware/**"
require "./channels/**"
<% if @project_type == "api" -%>
require "./responses/**"
require "./pages/**"
<% elsif @project_type == "web" -%>
require "./responses/**"
require "./pages/**"
<% end -%>
require "./endpoints/**"
<% end -%>
