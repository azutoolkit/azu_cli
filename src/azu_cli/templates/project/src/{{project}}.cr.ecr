<% if @project_type == "cli" -%>
require "option_parser"

module <%= @module_name %>
  VERSION = "0.1.0"

  def self.run(args : Array(String))
    option_parser = OptionParser.parse(args) do |parser|
      parser.banner = "Usage: <%= @project %> [options]"

      parser.on("-v", "--version", "Show version") do
        puts "v#{VERSION}"
        exit
      end

      parser.on("-h", "--help", "Show help") do
        puts parser
        exit
      end

<% if @include_example -%>
      parser.on("--hello NAME", "Say hello to NAME") do |name|
        puts "Hello, #{name}!"
        exit
      end
<% end -%>
    end

<% if @include_example -%>
    # If no arguments provided, show help
    if args.empty?
      puts option_parser
      exit
    end
<% end -%>
  end
end
<%= @module_name %>.run(ARGV)
<% else -%>
require "azu"
require "./initializers/**"
# Only the schema: src/db/seed.cr would run on every boot, and `azu db:migrate` requires the migrations itself.
require "./db/schema"

# Azu Framework Application
# Docs: https://azutoolkit.org
module <%= @module_name %>
  include Azu
  VERSION = "0.1.0"

  configure do |c|
<% if @project_type == "api" -%>
    # API Configuration
    # Uncomment to enable CORS
    # c.router.before "*", Handler::CORS.new
<% else -%>
    # Web Application Configuration
    # Uncomment to enable Spark real time apps
    # Docs: https://azutoolkit.org/spark
    # c.router.ws "/live-view", Spark
    c.templates.path = "./public/templates"
    # Serve static files
    c.router.get "/*", Handler::Static.new
<% end -%>
  end

<% if @project_type == "web" -%>
  Azu::Handler::CSRF.configure do |csrf|
    csrf.strategy = Azu::Handler::CSRF::Strategy::SignedDoubleSubmit
    # CSRF_SECRET must be in the process environment: export it (the generated .env lists one, but nothing
    # loads .env for you) or set it in your process manager. Development falls back to a random key per
    # process, which breaks forms behind several processes; production refuses to boot without it.
    csrf.secret_key = ENV["CSRF_SECRET"]?.presence || begin
      raise "CSRF_SECRET is not set" if Azu::CONFIG.env.production?
      Random::Secure.urlsafe_base64(64)
    end
  end

<% end -%>
  # A typed array: handing Azu an array of a union of handler classes as Array(HTTP::Handler) corrupts it
  # in optimized builds (IndexError / SIGSEGV at boot).
  def self.handlers : Array(HTTP::Handler)
    [
<% if @project_type == "web" -%>
      Azu::Handler::CSRF.default, # the instance configured above signs the tokens the forms render
<% end -%>
      Azu::Handler::RequestId.new,
      *dev_handlers,
      Azu::Handler::Rescuer.new,
      Azu::Handler::Logger.new,
    ] of HTTP::Handler
  end

  # Development tooling (query dashboard, performance monitor); decided when the app boots, so a
  # production process never serves it. This is the one place that wires it.
  def self.dev_handlers : Array(HTTP::Handler)
    return [] of HTTP::Handler unless Azu::CONFIG.env.development?

    [Azu::Handler::DevDashboard.new, Azu::Handler::PerformanceMonitor.new] of HTTP::Handler
  end
end

require "./models/**"
require "./requests/**"
require "./validators/**"
require "./services/**"
require "./components/**"
require "./middleware/**"
require "./channels/**"
<% if @project_type == "api" -%>
require "./responses/**"
require "./pages/**"
<% elsif @project_type == "web" -%>
require "./pages/**"
<% end -%>
require "./endpoints/**"
<% end -%>
