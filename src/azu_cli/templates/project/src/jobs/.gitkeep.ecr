# Jobs Directory
#
# Background jobs for JoobQ. src/initializers/joobq.cr requires every file here.
#
# To create a new job:
#   azu generate job SendEmail to:string subject:string body:string
#
# Then give it a queue that the worker runs, in src/initializers/joobq.cr:
#   JoobQ::QueueFactory.register_job_type(SendEmailJob)
#   JoobQ.config.queue_configs["default"] = {job_class_name: "SendEmailJob", workers: 2, throttle: nil}
