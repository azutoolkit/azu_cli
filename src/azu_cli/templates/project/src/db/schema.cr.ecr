# URL, adapter and pool settings come from CQL.config (src/initializers/cql_config.cr).
<%= schema_name %> = Azu::CQL.schema :<%= schema_symbol %> do
  table :cql_schema_migrations do
    primary :id, Int32
    text :name
    bigint :version
    timestamps
  end

  # Add your tables here
  # Example:
  # table :posts do
  #   primary :id, Int64
  #   text :title
  #   text :body
  #   boolean :published, default: "false"
  #   timestamps
  # end

end
