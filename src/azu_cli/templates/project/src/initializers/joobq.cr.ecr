# JoobQ's Redis store reads REDIS_HOST, REDIS_PORT and REDIS_PASS. REDIS_URL (`azu jobs:worker` sets it) supplies the
# ones that are not set; this runs before JoobQ builds a store, so enqueue, delay and the workers share one Redis.
if redis_url = ENV["REDIS_URL"]?
  redis = URI.parse(redis_url)
  ENV["REDIS_HOST"] ||= redis.host || "localhost"
  redis.port.try { |port| ENV["REDIS_PORT"] ||= port.to_s }
  redis.password.try { |password| ENV["REDIS_PASS"] ||= password }
end

require "joobq"
# Every job in src/jobs (`azu generate job SendEmail to:string` creates one there)
require "../jobs/**"

JoobQ.configure do |config|
  # Queue settings
  config.default_queue = "default"
  config.retries = 3
  config.timeout = 30.seconds
  config.expires = 1.day

  # Enable the REST API for development only (Azu reads CRYSTAL_ENV, not AZU_ENV)
  config.rest_api_enabled = ENV["CRYSTAL_ENV"]? != "production"

  # Enable statistics tracking
  config.stats_enabled = true
end

# The queues a worker (src/worker.cr, `azu jobs:worker`) runs: register the job class, then name its queue and
# its number of workers. JoobQ.forge starts the queues listed in queue_configs.
# JoobQ::QueueFactory.register_job_type(SendEmailJob)
# JoobQ.config.queue_configs["default"] = {job_class_name: "SendEmailJob", workers: 2, throttle: nil}

# Disable REST API for worker processes
if ARGV.includes?("--worker")
  JoobQ.config.rest_api_enabled = false
  Log.info { "JoobQ REST API disabled for worker process" }
end
