# Local settings and secrets. Git-ignored: never commit this file (copy .env.example for the full list).
# Loaded at boot by the app and by `azu` commands; a variable already in the environment wins over this file.
# Precedence: environment > .env.local > .env.<CRYSTAL_ENV> (.env.development, .env.test) > .env
CRYSTAL_LOG_SOURCES="*"
LOG_LEVEL=INFO
PORT=<%= port %>
PORT_REUSE=true
CSRF_SECRET=<%= csrf_secret %>
TEMPLATES_PATH=public/templates,public/templates/pages
