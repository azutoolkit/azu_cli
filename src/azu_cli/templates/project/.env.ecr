CRYSTAL_LOG_SOURCES="*"
LOG_LEVEL=INFO
PORT=4000
PORT_REUSE=true
HOST=0.0.0.0
SSL_CERT=
SSL_KEY=
SSL_CA=
SSL_MODE=
<% if database_adapter == "sqlite3" -%>
DATABASE_URL=sqlite3://./db/<%= @project.downcase %>_development.db
<% else -%>
DATABASE_URL=postgres://postgres:@localhost:5432/<%= @project.downcase %>_development_db
<% end -%>
CSRF_SECRET=<%= csrf_secret %>
TEMPLATES_PATH=public/templates,public/templates/pages
PERFORMANCE_MONITORING=true
