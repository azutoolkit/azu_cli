# Azu CLI Configuration
version: "1.0.0"

# Project settings
project:
  name: "<%= @project %>"
  type: "<%= @project_type %>"
<% if api_project? %>
  api_version: "v1"
  openapi_enabled: true
<% end %>

# Database configuration
database:
  adapter: "<%= database_adapter_uri_prefix %>"
  url: "${DATABASE_URL}"
<% unless database_adapter == "sqlite3" -%>
  host: "localhost"
  port: <%= database_adapter == "mysql" ? 3306 : 5432 %>
  database: "<%= @project %>_development"
  username: "<%= database_adapter == "mysql" ? "root" : "postgres" %>"
  password: ""
<% end -%>

# Server configuration
server:
  host: "localhost"
  port: <%= port %>
  environment: "development"
  reload: true

# Generator configuration
generators:
  templates_path: "src/azu_cli/templates"
  output_path: "src"
  test_output_path: "spec"

# Plugin configuration
plugins: {}
