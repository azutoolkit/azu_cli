# Every variable the app reads. The azu CLI applies a name from a .env file only if it looks like an application
# setting (DATABASE_URL, PORT, *_SECRET, *_URL, ...) or is listed here (this list only documents the settings; it is not a security control). Copy to .env (git-ignored) and fill in; real environment variables win over it.
# Files, highest precedence first: environment, .env.local, .env.<CRYSTAL_ENV>, .env

# development (default), test, staging or production
CRYSTAL_ENV=development
PORT=4000
HOST=0.0.0.0
PORT_REUSE=true
LOG_LEVEL=INFO
CRYSTAL_LOG_SOURCES="*"
TEMPLATES_PATH=public/templates,public/templates/pages

# Required in production, random per process otherwise. Generate with: openssl rand -hex 32
CSRF_SECRET=
# Needed once you generate authentication (azu generate auth)
SESSION_SECRET=

# Overrides the per-environment value in .env.development / .env.test
# DATABASE_URL=
