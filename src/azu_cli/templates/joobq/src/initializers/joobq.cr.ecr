# JoobQ reads REDIS_URL directly, preserving its database, credentials and TLS.
# Environment configuration wins over the generated development default.
unless ENV["REDIS_URL"]? || ENV["REDIS_HOST"]?
  ENV["REDIS_URL"] = <%= @redis_url.inspect %>
end

require "joobq"
require "../jobs/**"

# Queues name their job classes (config/joobq.<CRYSTAL_ENV>.yml, or the queue_configs below): register each one.
<% if @create_example_job -%>
JoobQ::QueueFactory.register_job_type(<%= @example_job_name %>)
<% end -%>
# JoobQ::QueueFactory.register_job_type(EmailJob)

environment = ENV["JOOBQ_ENV"]? || ENV["CRYSTAL_ENV"]? || "development"
config_file = "config/joobq.#{environment}.yml"

if File.exists?(config_file)
  JoobQ.initialize_config_with(:file, config_file)
else
  Log.warn { "JoobQ config file not found: #{config_file}, using defaults" }

  JoobQ.configure do |config|
    config.default_queue = <%= @default_queue.inspect %>
    config.retries = 5
    config.timeout = 30.seconds
    config.time_location = "UTC"
    config.worker_batch_size = 50
    config.rest_api_enabled = false
  end
<% if @create_example_job -%>
  # JoobQ.forge starts the queues listed in queue_configs
  JoobQ.config.queue_configs[<%= @default_queue.inspect %>] = {job_class_name: "<%= @example_job_name %>", workers: <%= @workers %>, throttle: nil}
<% end -%>
end

# Disable REST API for worker processes
if ARGV.includes?("--worker")
  JoobQ.config.rest_api_enabled = false
  Log.info { "JoobQ REST API disabled for worker process" }
end
