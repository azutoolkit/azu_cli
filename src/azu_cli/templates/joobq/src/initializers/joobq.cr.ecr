require "joobq"
require "../jobs/**"

# Queues from config/joobq.<CRYSTAL_ENV>.yml name their job classes: register each one here.
<% if @create_example_job -%>
JoobQ::QueueFactory.register_job_type(<%= @example_job_name %>)
<% end -%>
# JoobQ::QueueFactory.register_job_type(EmailJob)

environment = ENV["CRYSTAL_ENV"]? || "development"
config_file = "config/joobq.#{environment}.yml"
redis_url = ENV["REDIS_URL"]?

if File.exists?(config_file)
  JoobQ.initialize_config_with(:file, config_file)
else
  Log.warn { "JoobQ config file not found: #{config_file}, using defaults" }
  redis_url ||= <%= @redis_url.inspect %>

  JoobQ.configure do |config|
    config.default_queue = <%= @default_queue.inspect %>
    config.retries = 5
    config.timeout = 30.seconds
    config.time_location = "UTC"
    config.worker_batch_size = 50
    config.rest_api_enabled = true
<% if @create_example_job -%>
    queue <%= @default_queue.inspect %>, <%= @workers %>, <%= @example_job_name %>
<% end -%>
  end
end

# JoobQ's Redis store takes a host, a port and a password; REDIS_URL (`azu jobs:worker` sets it) names all three.
if redis_url
  redis = URI.parse(redis_url)
  JoobQ.config.store = JoobQ::RedisStore.new(host: redis.host || "localhost", port: redis.port || 6379, password: redis.password)
end

# Disable REST API for worker processes
if ARGV.includes?("--worker")
  JoobQ.config.rest_api_enabled = false
  Log.info { "JoobQ REST API disabled for worker process" }
end
