{% extends "app_layout.jinja" %}

{% block title %}New <%= resource_singular.tr("_", " ") %>{% endblock %}

{% block content %}
<div class="page-head"><h1>New <%= resource_singular.tr("_", " ") %></h1></div>
{% set form_action = "/<%= resource_plural %>" %}
{% include "<%= app_dir %>/<%= resource_plural %>/_form.jinja" %}
{% endblock %}
