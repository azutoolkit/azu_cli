{% extends "app_layout.jinja" %}
{% block title %}New <%= resource_singular.tr("_", " ") %>{% endblock %}
{% block content %}
<div class="mx-auto max-w-3xl space-y-6">
  <div class="breadcrumbs text-sm text-base-content/60"><ul><li><a href="/<%= resource_plural %>"><%= namespace %></a></li><li>New</li></ul></div>
  <div><h1 class="text-3xl font-semibold tracking-tight">New <%= resource_singular.tr("_", " ") %></h1><p class="mt-2 text-base-content/70">Add the details below to get started.</p></div>
  <section class="card border border-base-300 bg-base-100 shadow-sm"><div class="card-body p-6 sm:p-8">
    {% set form_action = "/<%= resource_plural %>" %}
    {% include "<%= app_dir %>/<%= resource_plural %>/_form.jinja" %}
  </div></section>
</div>
{% endblock %}
