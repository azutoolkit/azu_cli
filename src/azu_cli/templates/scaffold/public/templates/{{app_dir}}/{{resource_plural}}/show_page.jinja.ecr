{% extends "app_layout.jinja" %}

{% block title %}<%= model_name %> #{{ <%= resource_singular %>.id }}{% endblock %}

{% block content %}
<div class="page-head">
  <h1><%= model_name %> #{{ <%= resource_singular %>.id }}</h1>
</div>

<dl class="stack">
<% fields.each do |field| -%>
  <div><dt><%= field.label %></dt><dd>{{ <%= resource_singular %>.<%= field.name %> | e }}</dd></div>
<% end -%>
</dl>

<div class="row">
  <a class="btn" href="/<%= resource_plural %>/{{ <%= resource_singular %>.id }}/edit">Edit</a>
  <a class="btn btn--secondary" href="/<%= resource_plural %>">Back</a>
  <form action="/<%= resource_plural %>/{{ <%= resource_singular %>.id }}" method="post">
    {{ csrf_tag | safe }}
    <input type="hidden" name="_method" value="delete">
    <button class="btn btn--secondary" type="submit">Delete</button>
  </form>
</div>
{% endblock %}
