{% extends "app_layout.jinja" %}
{% block title %}Edit <%= resource_singular.tr("_", " ") %>{% endblock %}
{% block content %}
<div class="mx-auto max-w-3xl space-y-6">
  <div class="breadcrumbs text-sm text-base-content/60"><ul><li><a href="/<%= resource_plural %>"><%= namespace %></a></li><li>Edit</li></ul></div>
  <div><h1 class="text-3xl font-semibold tracking-tight">Edit <%= resource_singular.tr("_", " ") %> #{{ <%= resource_singular %>.id }}</h1><p class="mt-2 text-base-content/70">Make your changes and save when you are ready.</p></div>
  <section class="card border border-base-300 bg-base-100 shadow-sm"><div class="card-body p-6 sm:p-8">
    {% set form_action = "/<%= resource_plural %>/" ~ <%= resource_singular %>.id %}
    {% set form_method = "patch" %}
    {% include "<%= app_dir %>/<%= resource_plural %>/_form.jinja" %}
  </div></section>
</div>
{% endblock %}
