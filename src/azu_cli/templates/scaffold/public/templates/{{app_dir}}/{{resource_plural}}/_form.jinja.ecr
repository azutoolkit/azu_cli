<form action="{{ form_action }}" method="post" class="stack">
  {{ csrf_tag | safe }}
  {% if form_method %}<input type="hidden" name="_method" value="{{ form_method }}">{% endif %}
<% fields.each do |field| -%>
<% if field.input == "checkbox" -%>
  <label class="field field--check">
    <input type="checkbox" name="<%= field.name %>" value="true"{% if <%= resource_singular %>.<%= field.name %> %} checked{% endif %}>
    <%= field.label %>
  </label>
<% elsif field.input == "textarea" -%>
  <label class="field"><%= field.label %>
    <textarea name="<%= field.name %>" rows="6"<%= " required" unless field.nilable? %>>{{ <%= resource_singular %>.<%= field.name %> | e }}</textarea>
  </label>
<% else -%>
  <label class="field"><%= field.label %>
    <input type="<%= field.input %>"<%= %( step="any") if field.input == "number" && !field.crystal_type.starts_with?("Int") %> name="<%= field.name %>" value="{{ <%= resource_singular %>.<%= field.name %> | e }}"<%= " required" unless field.nilable? %>>
  </label>
<% end -%>
<% end -%>
  <div class="row">
    <button class="btn" type="submit">Save</button>
    <a class="btn btn--secondary" href="/<%= resource_plural %>">Cancel</a>
  </div>
</form>
