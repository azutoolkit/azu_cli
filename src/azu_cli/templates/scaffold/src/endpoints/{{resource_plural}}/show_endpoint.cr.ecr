module <%= app_module %>
  struct <%= namespace %>::ShowEndpoint
    include Azu::Endpoint(<%= request_type %>, <%= response_type %>)

    get "<%= route %>"

    def call : <%= response_type %>
      content_type "<%= media_type %>"
      record = <%= find_record %>
<% if api? -%>
      <%= response_type %>.new(record)
<% else -%>
      <%= response_type %>.new(record, csrf_tag)
<% end -%>
    end
  end
end
