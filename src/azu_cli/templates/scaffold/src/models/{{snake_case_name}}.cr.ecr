require "cql"

class <%= model_name %>
  <%= include_statement %>
  <%= db_context_declaration %>

<% fields.each do |field| -%>
<% if field.kind == "uuid" -%>
  @[DB::Field(converter: <%= field.nilable? ? "::#{model_name}::NullableUUIDConverter" : "CQL::UUIDConverter" %>)]
<% end -%>
  property <%= field.name %> : <%= field.crystal_type %>
<% end -%>
<% if fields.any? { |field| field.kind == "uuid" && field.nilable? } -%>

  module NullableUUIDConverter
    def self.from_rs(rs : DB::ResultSet) : UUID?
      rs.read(String?).try { |value| UUID.new(value) }
    end

    def self.to_db(value : UUID?) : String?
      value.try(&.to_s)
    end
  end
<% end -%>
<% if @timestamps -%>
  property created_at : Time?
  property updated_at : Time?
<% end -%>
<% unless associations.empty? -%>

<% associations.each do |association| -%>
  <%= association %>
<% end -%>
<% end -%>

  def initialize(<%= constructor_params %>)
  end
end
