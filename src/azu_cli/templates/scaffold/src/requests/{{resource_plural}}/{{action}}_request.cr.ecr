module <%= app_module %>
  struct <%= namespace %>::<%= request_struct_name %>
    include Azu::Request
<% if id? || fields? -%>

<% end -%>
<% if id? -%>
    getter id : Int64
<% end -%>
<% if fields? -%>
<% fields.each do |field| -%>
    getter <%= field.name %> : <%= type_of(field) %><%= default_of(field) %>
<% end -%>
<% unless validated_fields.empty? -%>

<% validated_fields.each do |field| -%>
    validate <%= field.name %>, <%= validation %>
<% end -%>
<% end -%>
<% end -%>
  end
end
