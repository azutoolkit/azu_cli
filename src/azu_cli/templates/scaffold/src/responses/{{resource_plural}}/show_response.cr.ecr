require "json"

module <%= app_module %>
  struct <%= namespace %>::ShowResponse
    include Azu::Response::Negotiable
    include JSON::Serializable

    getter id : Int64?
<% fields.each do |field| -%>
    getter <%= field.name %> : <%= field.crystal_type %>
<% end -%>

    def initialize(record : <%= model_name %>)
      @id = record.id
<% fields.each do |field| -%>
      @<%= field.name %> = record.<%= field.name %>
<% end -%>
    end

    def render_json : String
      to_json
    end
  end
end
