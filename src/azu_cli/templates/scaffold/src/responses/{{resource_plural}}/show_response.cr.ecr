require "json"

module <%= app_module %>
  struct <%= namespace %>::ShowResponse
    include Azu::Response
    include JSON::Serializable

    getter id : Int64?
<% fields.each do |field| -%>
    getter <%= field.name %> : <%= field.crystal_type %>
<% end -%>

    def initialize(<%= resource_singular %> : <%= model_name %>)
      @id = <%= resource_singular %>.id
<% fields.each do |field| -%>
      @<%= field.name %> = <%= resource_singular %>.<%= field.name %>
<% end -%>
    end

    def render : String
      to_json
    end
  end
end
