module <%= app_module %>
  struct <%= namespace %>::EditPage
    include Azu::Response::Negotiable
    include Azu::Templates::Renderable

    def initialize(@<%= resource_singular %> : <%= model_name %>, @csrf_tag : String)
    end

    def render_html : String
      values = @<%= resource_singular %>.attributes.transform_keys(&.to_s).transform_values do |value|
        case value
        when Time      then value.to_rfc3339
        when JSON::Any then value.to_json
        else                value
        end
      end
      view data: {"<%= resource_singular %>" => values, "csrf_tag" => @csrf_tag}
    end
  end
end
