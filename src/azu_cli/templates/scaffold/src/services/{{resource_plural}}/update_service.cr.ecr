module <%= app_module %>
  class <%= namespace %>::UpdateService
    def call(record : <%= model_name %>, request : <%= request_type %>) : <%= model_name %>
<% changes.each do |change| -%>
      <%= change %>
<% end -%>
      record.save!
<% if broadcast? -%>
      Azu::PubSub.broadcast("<%= app_dir %>:<%= resource_plural %>:changed", "changed")
<% end -%>
      record
    end
  end
end
