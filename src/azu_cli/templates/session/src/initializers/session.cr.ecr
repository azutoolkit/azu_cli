require "session"
<%- if backend == "redis" -%>
require "redis"
<%- end -%>

# The visitor's session, typed: add the properties your app keeps (`property user_id : Int64? = nil`).
class UserSession < Session::Base
end

Session.use_store(Session::<%= store_type %>(UserSession))

Session.configure do |config|
  # SESSION_SECRET comes from the environment or the git-ignored .env. Development falls back to a random key
  # per process; production refuses to boot without it.
  config.secret = Azu::Env.secret("SESSION_SECRET")
  config.session_key = "<%= project.gsub(/[^a-zA-Z0-9_]/, "_") %>_session"
  config.timeout = 24.hours
<%- if backend == "redis" -%>
  config.store = Session::RedisStore(UserSession).new(Redis.new(url: ENV["REDIS_URL"]? || "redis://localhost:6379"))
<%- else -%>
  config.store = Session::<%= store_type %>(UserSession).new
<%- end -%>
end
