# <%=camel_case_name%> Mailer
# Email functionality for <%=name%> using Carbon
# Carbon: https://github.com/luckyframework/carbon
#
# Usage:
#   mailer = <%=camel_case_name%>Mailer.new
#   email = mailer.welcome(to: Carbon::Address.new("user@example.com"), name: "John")
#   email.deliver
<%- if async %>
#
#   # Or send asynchronously:
#   mailer.welcome_later(to: Carbon::Address.new("user@example.com"), name: "John")
<%- end %>

require "carbon"

# A factory composes messages; Carbon owns delivery through its configured adapter.
class <%=camel_case_name%>Mailer
  abstract class Delivery < Carbon::Email
    def deliver
      result = super
      {% if @top_level.has_constant?("Azu") && Azu.has_constant?("Dev") && Azu::Dev.has_constant?("IntegrationEvents") %}
        Azu::Dev::IntegrationEvents.delivery("<%=camel_case_name%>Mailer", "delivered")
      {% end %}
      result
    rescue ex
      {% if @top_level.has_constant?("Azu") && Azu.has_constant?("Dev") && Azu::Dev.has_constant?("IntegrationEvents") %}
        Azu::Dev::IntegrationEvents.delivery("<%=camel_case_name%>Mailer", "failed")
      {% end %}
      raise ex
    end
  end

  class Message < Delivery
    getter to : Array(Carbon::Address)
    getter from : Carbon::Address
    getter subject : String
    getter text_body : String
    getter html_body : String

    def initialize(@to, @from, @subject, @text_body, @html_body)
    end
  end

  # Configure mailer defaults
  def from_email : String
    ENV["MAILER_FROM_EMAIL"]? || "noreply@example.com"
  end

  def from_name : String
    ENV["MAILER_FROM_NAME"]? || "<%=camel_case_name.split("Mailer").first%>"
  end

<%=mailer_methods%>

<%=async_methods%>

  # Render text template
  private def render_text(template : String, params : Hash(String, String)) : String
    # TODO: Implement text template rendering
    # You can use ECR, Jinja, or any template engine
    # Example with ECR:
    # ECR.render "src/mailers/templates/#{template}.txt.ecr"

    "Text version of #{template}"
  end

  # Render HTML template
  private def render_html(template : String, params : Hash(String, String)) : String
    # TODO: Implement HTML template rendering
    # You can use ECR, Jinja, or any template engine
    # Example with ECR:
    # ECR.render "src/mailers/templates/#{template}.html.ecr"

    "<html><body><h1>#{template}</h1></body></html>"
  end

  # Preview emails in development
  # Call <%=camel_case_name%>Mailer.preview("<%=template_names.first%>") from your development tooling.
  def self.preview(method_name : String)
    mailer = new
    case method_name
<%- template_names.each do |method_name| %>
    when "<%=method_name%>"
      mailer.<%=method_name%>(
        to: Carbon::Address.new("Preview User", "preview@example.com")
        # Add preview params here
      )
<%- end %>
    else
      raise "Unknown method: #{method_name}"
    end
  end
end

# Configure Carbon adapter based on environment
<%=adapter_config%>

{% if @top_level.has_constant?("Azu") && Azu.has_constant?("Dev") && Azu::Dev.has_constant?("IntegrationEvents") %}
  # Static sample; never includes real recipients or message content.
  Azu::Dev::IntegrationEvents.mailer("<%=camel_case_name%>Mailer", "Text version of <%=snake_case_name%>/<%=template_names.first%>")
{% end %}
