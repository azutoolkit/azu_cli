module <%= app_module %>
  # Limits how often one client can try to sign in or sign up: a fixed window counter per key, in memory.
  #
  # It counts per process: behind several processes (or hosts) each one allows the limit, so scale the limits down
  # or count in a shared store (Redis) when that matters. A restart forgets the counts.
  #
  # Settings, read from the environment when the app boots:
  #   AUTH_THROTTLE_LOGIN        sign-in attempts per window for one client address and email (default 5)
  #   AUTH_THROTTLE_ADDRESS      sign-in attempts per window for one client address, any email (default 20)
  #   AUTH_THROTTLE_REGISTER     sign-up attempts per window for one client address (default 5)
  #   AUTH_THROTTLE_WINDOW       seconds in a window (default 60)
  #   AUTH_THROTTLE_TRUST_PROXY  "true" to take the client address from the last X-Forwarded-For entry,
  #                              which only a proxy you run may append; leave it unset otherwise, the header is
  #                              client-controlled
  # An attempt over the limit answers 429 with a Retry-After header. Attempts that fail validation (422) are not counted.
  #
  # There is deliberately no counter per email alone: it would let anyone lock a known account out by failing 20
  # sign-ins for it from their own address. Every source gets its own budget per account; guessing spread over many
  # addresses needs a shared store, a CAPTCHA or an account lock the owner can clear, which are not generated.
  #
  # At most MAX_KEYS counters are kept (an attacker can choose the keys): when the table is full the counter whose
  # window ends first is dropped, which is an expired one if there is any. Memory and the time per attempt stay
  # bounded; with MAX_KEYS live counters (that many distinct addresses in one window) a live counter is evicted too,
  # so a flood from that many addresses can reset other clients' counts.
  class AuthThrottle
    WINDOW        = setting("AUTH_THROTTLE_WINDOW", 60).seconds
    MAX_KEYS      = 10_000
    TRUST_PROXY   = ENV["AUTH_THROTTLE_TRUST_PROXY"]? == "true"
    FORWARDED_FOR = "X-Forwarded-For"

    class_getter login : AuthThrottle = new(setting("AUTH_THROTTLE_LOGIN", 5), WINDOW)
    class_getter address : AuthThrottle = new(setting("AUTH_THROTTLE_ADDRESS", 20), WINDOW)
    class_getter register : AuthThrottle = new(setting("AUTH_THROTTLE_REGISTER", 5), WINDOW)

    private record Counter, count : Int32, resets_at : Time::Instant

    getter limit : Int32

    def initialize(@limit : Int32, @window : Time::Span)
      @counters = Hash(String, Counter).new
      @mutex = Mutex.new
    end

    # A positive integer from the environment, else the default.
    def self.setting(name : String, default : Int32) : Int32
      value = ENV[name]?.try(&.to_i?)
      value && value > 0 ? value : default
    end

    # The address that made the request: the peer of the connection, or with AUTH_THROTTLE_TRUST_PROXY the last
    # X-Forwarded-For entry.
    def self.client_address(request : HTTP::Request) : String
      forwarded = request.headers[FORWARDED_FOR]?.try(&.split(',').last?.try(&.strip)) if TRUST_PROXY
      return forwarded if forwarded && !forwarded.empty?

      case address = request.remote_address
      when Socket::IPAddress then address.address
      else                        "unknown"
      end
    end

    # Counts an attempt for `key`. Returns nil when it is allowed, else the seconds to wait before the next one.
    def attempt(key : String, now : Time::Instant = Time.instant) : Int32?
      @mutex.synchronize do
        counter = @counters[key]?
        if counter.nil? || counter.resets_at <= now
          start_window(key, now)
          nil
        elsif counter.count < limit
          @counters[key] = Counter.new(counter.count + 1, counter.resets_at)
          nil
        else
          Math.max(1, (counter.resets_at - now).total_seconds.ceil.to_i)
        end
      end
    end

    def size : Int32
      @mutex.synchronize { @counters.size }
    end

    # Raises a 429 (with Retry-After) when `key` is over the limit.
    def attempt!(key : String) : Nil
      if wait = attempt(key)
        raise Azu::Response::RateLimitError.new(retry_after: wait)
      end
    end

    # Entries are kept in the order their windows end (a new window is appended, a counted attempt keeps its place),
    # so the first entry is the one that ends first (an expired one when there is any).
    private def start_window(key : String, now : Time::Instant) : Nil
      @counters.delete(key)
      make_room
      @counters[key] = Counter.new(1, now + @window)
    end

    private def make_room : Nil
      while @counters.size >= MAX_KEYS
        @counters.delete(@counters.first_key)
      end
    end
  end
end
