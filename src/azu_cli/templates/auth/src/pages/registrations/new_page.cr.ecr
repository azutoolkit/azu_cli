module <%= app_module %>
  struct Registrations::NewPage
    include Azu::Response::Negotiable
    include Azu::Templates::Renderable

    def initialize(@csrf_tag : String, @messages : Hash(String, String))
    end

    def render_html : String
      view data: {"csrf_tag" => @csrf_tag, "messages" => @messages}
    end
  end
end
