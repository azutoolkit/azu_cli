require "session"

# The session lives in an encrypted cookie, so it works behind any number of processes.
class UserSession < Session::Base
  property user_id : Int64? = nil

  def authenticated? : Bool
    !user_id.nil?
  end
end

Session.use_store(Session::CookieStore(UserSession))

Session.configure do |config|
  # SESSION_SECRET must be in the process environment: export it (the generated .env lists one, but
  # nothing loads .env for you) or set it in your process manager. Development falls back to a random
  # key per process, which signs users out on every restart; production refuses to boot without it.
  config.secret = ENV["SESSION_SECRET"]?.presence || begin
    raise "SESSION_SECRET is not set" if ENV["CRYSTAL_ENV"]? == "production"
    Random::Secure.hex(32)
  end
  config.session_key = "<%= app_dir %>_session"
  config.store = Session::CookieStore(UserSession).new
end
