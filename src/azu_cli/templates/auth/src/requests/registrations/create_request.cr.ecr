module <%= app_module %>
  struct Registrations::CreateRequest
    include Azu::Request

    getter email : String
    getter password : String

    validate email, presence: true, size: 3..254, match: /\A[^@\s]+@[^@\s]+\z/
    validate password, presence: true, size: 8..72, max_bytes: 72
  end
end
