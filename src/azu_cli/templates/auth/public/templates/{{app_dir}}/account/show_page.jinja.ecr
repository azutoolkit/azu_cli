{% extends "app_layout.jinja" %}
{% block title %}Account{% endblock %}
{% block content %}
<div class="mx-auto max-w-3xl space-y-6">
  <div><p class="text-xs font-semibold uppercase tracking-widest text-primary">Your workspace</p><h1 class="mt-2 text-3xl font-semibold tracking-tight">Account</h1><p class="mt-2 text-sm text-base-content/70">Your profile and sign-in details.</p></div>
  <section class="card border border-base-300 bg-base-100 shadow-sm"><div class="card-body gap-6 p-6 sm:p-8">
    <div class="flex flex-wrap items-center gap-5">
      <div class="avatar avatar-placeholder"><div class="w-20 rounded-2xl bg-primary/10 text-primary"><svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg></div></div>
      <div class="min-w-0"><span class="badge badge-success badge-soft mb-2">Signed in</span><p class="break-all font-semibold">{{ email | e }}</p><p class="mt-1 text-sm text-base-content/60">Your personal workspace account</p></div>
    </div>
    <div class="border-t border-base-300 pt-6"><p class="mb-4 text-sm text-base-content/70">Finished for now? Sign out on this browser.</p><form action="/logout" method="post">
      {{ csrf_tag | safe }}<input type="hidden" name="_method" value="delete"><button class="btn btn-outline" type="submit">Sign out</button>
    </form></div>
  </div></section>
</div>
{% endblock %}
