{% extends "app_layout.jinja" %}
{% block title %}Sign up{% endblock %}
{% block content %}
<div class="mx-auto max-w-md py-6 sm:py-12">
  <div class="mb-8 space-y-3 text-center"><span class="badge badge-primary badge-soft">Your workspace</span><h1 class="text-3xl font-semibold tracking-tight">Create your account</h1><p class="text-sm text-base-content/70">A fresh workspace starts with you.</p></div>
  <section class="card border border-base-300 bg-base-100 shadow-sm"><div class="card-body gap-6 p-6 sm:p-8">
    {% if messages.notice %}<p class="alert alert-success alert-soft text-sm" role="status">{{ messages.notice | e }}</p>{% endif %}
    {% if messages.error %}<p class="alert alert-error alert-soft text-sm" role="alert">{{ messages.error | e }}</p>{% endif %}
    <form action="/register" method="post" class="space-y-5">
      {{ csrf_tag | safe }}
      <label class="fieldset block space-y-2"><span class="fieldset-legend p-0">Email</span>
        <input class="input w-full" type="email" name="email" autocomplete="email" placeholder="you@example.com" required>
      </label>
      <label class="fieldset block space-y-2"><span class="fieldset-legend p-0">Password</span>
        <input class="input w-full" type="password" name="password" autocomplete="new-password" minlength="8" maxlength="72" aria-describedby="password-help" required>
      </label>
      <p id="password-help" class="text-xs text-base-content/60">Use at least 8 characters. A long, unique password works best.</p>
      <button class="btn btn-primary w-full" type="submit">Create account</button>
    </form>
    <p class="text-center text-sm text-base-content/70">Already have an account? <a class="link link-primary font-medium" href="/login">Sign in</a></p>
  </div></section>
</div>
{% endblock %}
